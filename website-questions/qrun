#!/usr/bin/env bash
# qrun: run q-NN-KK.c programs and maintain output.md + output.json.
# Requires Bash, Python 3, and util-linux `script` (for interactive input/output capture).
set -uo pipefail

SELF_PATH="$(realpath -- "${BASH_SOURCE[0]}")" || exit 1

# Internal updater is embedded so this remains a single installable script.
if [[ "${1:-}" == "--_update" ]]; then
    shift
    exec python3 - "$@" <<'PYTHON_HELPER'
import hashlib
import json
import os
import re
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path


def now():
    return datetime.now().astimezone().isoformat(timespec="seconds")


def die(message, code=1):
    print(f"qrun: error: {message}", file=sys.stderr)
    raise SystemExit(code)


def load_json(path):
    if not path.exists():
        return {"schema_version": 1, "entries": []}, False
    try:
        with path.open("r", encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        die(f"cannot read {path.name} as valid JSON ({exc}); left it untouched")
    if not isinstance(data, dict):
        die(f"{path.name} must contain a JSON object at the top level; left it untouched")
    if "entries" not in data:
        data["entries"] = []
    if not isinstance(data["entries"], list):
        die(f'{path.name}: "entries" must be a JSON array; left it untouched')
    ids = []
    for item in data["entries"]:
        if not isinstance(item, dict):
            die(f'{path.name}: every item in "entries" must be a JSON object; left it untouched')
        item_id = item.get("id")
        if item_id is not None:
            ids.append(item_id)
    duplicate_ids = sorted({x for x in ids if ids.count(x) > 1})
    if duplicate_ids:
        die(f"duplicate entry IDs in {path.name}: {', '.join(duplicate_ids)}; left it untouched")
    return data, True


def parse_question_file(path, root):
    name_match = re.fullmatch(r"q-(\d{2,})-(\d{2,})\.c", path.name)
    if not name_match:
        return None
    topic_index = int(name_match.group(1))
    question_number = int(name_match.group(2))
    entry_id = f"q-{topic_index:02d}-{question_number:02d}"
    try:
        raw = path.read_bytes()
        code = raw.decode("utf-8")
    except UnicodeDecodeError:
        die(f"{path}: source is not valid UTF-8; cannot safely preserve it")
    except OSError as exc:
        die(f"cannot read {path}: {exc}")

    topic = None
    question = None
    # The first matching single-line // header is authoritative; keep question text verbatim.
    header_re = re.compile(r"^\s*//\s*(.*?)\s*->\s*Q\s*\d+\s*:\s?(.*)$")
    for line in code.splitlines():
        match = header_re.match(line)
        if match:
            topic = match.group(1).strip()
            question = match.group(2)
            break

    if topic is None or question is None:
        fallback = find_in_questions_md(root, topic_index, question_number)
        if fallback:
            topic, question = fallback
        else:
            topic = topic or f"Topic {topic_index:02d}"
            question = question or f"Question {question_number:02d} (no question header found)"

    try:
        relative_path = os.path.relpath(str(path.resolve()), str(root.resolve()))
    except OSError:
        relative_path = str(path)
    return {
        "id": entry_id,
        "topic": topic,
        "topic_index": topic_index,
        "question_number": question_number,
        "question": question,
        "source_file": relative_path,
        "code": code,
        "code_sha256": hashlib.sha256(raw).hexdigest(),
        "_path": str(path.resolve()),
    }


def find_in_questions_md(root, topic_index, question_number):
    candidates = [root / "questions.md"]
    # Also accept a questions.md beside the source if it is outside the output directory.
    for p in root.glob("q-*.c"):
        candidates.append(p.resolve().parent / "questions.md")
    for md_path in candidates:
        try:
            text = md_path.read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            continue
        topics = []
        current = None
        for line in text.splitlines():
            heading = re.match(r"^#\s+(.+?)\s*$", line)
            if heading:
                current = {"name": heading.group(1), "questions": {}}
                topics.append(current)
                continue
            item = re.match(r"^\s*(\d+)\.\s+(.*)$", line)
            if item and current is not None:
                current["questions"][int(item.group(1))] = item.group(2)
        if 0 <= topic_index < len(topics):
            topic = topics[topic_index]["name"]
            question = topics[topic_index]["questions"].get(question_number)
            if question is not None:
                return topic, question
    return None


def scan_sources(root):
    found = {}
    for path in sorted(root.glob("q-*.c")):
        meta = parse_question_file(path, root)
        if meta is None:
            continue
        if meta["id"] in found:
            die(f"multiple source files resolve to {meta['id']}: {found[meta['id']]['source_file']} and {meta['source_file']}")
        found[meta["id"]] = meta
    return found


def fence(text, language):
    runs = [len(m.group(0)) for m in re.finditer(r"`+", text)]
    ticks = "`" * max(3, (max(runs) + 1) if runs else 3)
    body = text
    if not body.endswith("\n"):
        body += "\n"
    return f"{ticks}{language}\n{body}{ticks}"


def marker(kind, item_id, side):
    if kind == "topic-block":
        return f'<!-- qrun:topic-{side} id="{item_id}" -->'
    if kind == "entry-block":
        return f'<!-- qrun:entry-{side} id="{item_id}" -->'
    return f'<!-- qrun:field-{side} {kind} id="{item_id}" -->'


def field_pattern(kind, item_id):
    start = re.escape(marker(kind, item_id, "start"))
    end = re.escape(marker(kind, item_id, "end"))
    return re.compile(start + r"\n?(.*?)" + end, re.DOTALL)


def replace_field(text, kind, item_id, body, required=False):
    pat = field_pattern(kind, item_id)
    matches = list(pat.finditer(text))
    if len(matches) > 1:
        die(f"output.md has duplicate {kind} field markers for {item_id}; left it untouched")
    if not matches:
        if required:
            die(f"output.md is missing the {kind} field markers for {item_id}; left it untouched")
        return text, False
    replacement = marker(kind, item_id, "start") + "\n\n" + body.rstrip("\n") + "\n\n" + marker(kind, item_id, "end")
    new = text[:matches[0].start()] + replacement + text[matches[0].end():]
    return new, new != text


def topic_heading(meta):
    return f"# {meta['topic']}"


def question_heading(meta):
    # Question wording is pulled directly from the C header (or questions.md fallback).
    return f"## Q {meta['question_number']:02d} : {meta['question']}"


def freshness_note(meta, record):
    if not isinstance(record, dict):
        return ""
    runs = record.get("runs", [])
    if not isinstance(runs, list) or not runs:
        return ""
    last_run = runs[-1]
    if not isinstance(last_run, dict):
        return ""
    captured_hash = last_run.get("code_sha256")
    if captured_hash and captured_hash != meta.get("code_sha256"):
        filename = Path(meta.get("source_file", "source.c")).name
        return f"> **Output may be stale:** `{filename}` changed after this output was captured. Run `qrun {filename}` to refresh it."
    return ""


def entry_block(meta, output_display, freshness=""):
    qid = meta["id"]
    pieces = [
        marker("entry-block", qid, "start"),
        "",
        marker("question", qid, "start"),
        "",
        question_heading(meta),
        "",
        marker("question", qid, "end"),
        "",
        "### CODE",
        "",
        marker("code", qid, "start"),
        "",
        fence(meta["code"], "c"),
        "",
        marker("code", qid, "end"),
        "",
        "### OUTPUT",
        "",
        marker("freshness", qid, "start"),
        "",
        freshness,
        "",
        marker("freshness", qid, "end"),
        "",
        marker("output", qid, "start"),
        "",
        fence(output_display, "text"),
        "",
        marker("output", qid, "end"),
        marker("entry-block", qid, "end"),
    ]
    return "\n".join(pieces)


def create_entry_block(meta, output_display="(not run yet)", freshness=""):
    return entry_block(meta, output_display, freshness)


def locate_block(text, kind, item_id):
    start = marker(kind, item_id, "start")
    end = marker(kind, item_id, "end")
    if text.count(start) > 1 or text.count(end) > 1:
        die(f"output.md has duplicate {kind} markers for {item_id}; left it untouched")
    if (start in text) != (end in text):
        die(f"output.md has an unmatched {kind} marker for {item_id}; left it untouched")
    if start not in text:
        return None
    a = text.index(start)
    b = text.index(end, a) + len(end)
    if b < a:
        die(f"output.md has malformed {kind} markers for {item_id}; left it untouched")
    return a, b


def update_markdown(path, sources, entries, current_id=None, current_output=None):
    existed = path.exists()
    try:
        original = path.read_text(encoding="utf-8") if existed else ""
    except (OSError, UnicodeError) as exc:
        die(f"cannot read {path.name} ({exc}); left it untouched")
    text = original
    records_by_id = {item.get("id"): item for item in entries if isinstance(item, dict) and item.get("id")}
    # If output.md was removed but JSON still exists, rebuild the managed sections from JSON records.
    # This recovery path only runs when the Markdown file is genuinely absent; existing user content is never discarded.
    if not existed and records_by_id:
        groups = {}
        for record in entries:
            qid = record.get("id") if isinstance(record, dict) else None
            meta = sources.get(qid)
            if meta is None:
                continue
            if qid == current_id and current_output is not None:
                display = current_output
            else:
                command_line = f"$ {record.get('command', '')}".rstrip()
                transcript = record.get("output", "") or ""
                display = "\n".join([command_line, transcript]).rstrip("\n")
            groups.setdefault(meta["topic_index"], []).append((meta, display, freshness_note(meta, record)))
        recovered = []
        for topic_index, topic_entries in groups.items():
            first_meta = topic_entries[0][0]
            topic_id = f"topic-{topic_index:02d}"
            recovered.extend([
                marker("topic-block", topic_id, "start"),
                "",
                marker("topic", topic_id, "start"),
                "",
                topic_heading(first_meta),
                "",
                marker("topic", topic_id, "end"),
                "",
            ])
            for meta, display, freshness in topic_entries:
                recovered.append(create_entry_block(meta, display, freshness))
                recovered.append("")
            recovered.append(marker("topic-block", topic_id, "end"))
            recovered.append("")
        text = "\n".join(recovered).rstrip("\n") + ("\n" if recovered else "")
    # Update all source snapshots already represented in the Markdown.
    existing_ids = set(re.findall(r'<!-- qrun:entry-start id="(q-[0-9]+-[0-9]+)" -->', text))
    for qid in sorted(existing_ids):
        meta = sources.get(qid)
        if meta is None:
            continue
        topic_id = f"topic-{meta['topic_index']:02d}"
        # These are required for a generated entry. Never partially overwrite a damaged entry.
        for kind in ("question", "code", "freshness", "output"):
            loc = locate_block(text, "entry-block", qid)
            if loc is None:
                die(f"output.md is missing entry markers for {qid}; left it untouched")
            pat = field_pattern(kind, qid)
            if len(list(pat.finditer(text[loc[0]:loc[1]]))) != 1:
                die(f"output.md has missing/duplicate {kind} fields for {qid}; left it untouched")
        text, _ = replace_field(text, "question", qid, question_heading(meta), required=True)
        text, _ = replace_field(text, "code", qid, fence(meta["code"], "c"), required=True)
        text, _ = replace_field(text, "freshness", qid, freshness_note(meta, records_by_id.get(qid)), required=True)
        # Retain the output field unless this question was run this invocation.
        if qid == current_id and current_output is not None:
            text, _ = replace_field(text, "output", qid, fence(current_output, "text"), required=True)
        # The topic heading field is managed once per topic, not per question.
        loc_topic = locate_block(text, "topic-block", topic_id)
        if loc_topic is not None:
            text, _ = replace_field(text, "topic", topic_id, topic_heading(meta), required=True)

    # Insert or update the current entry, creating its topic section if necessary.
    if current_id is not None:
        meta = sources[current_id]
        topic_id = f"topic-{meta['topic_index']:02d}"
        output_display = current_output if current_output is not None else "(not run yet)"
        freshness = freshness_note(meta, records_by_id.get(current_id))
        topic_loc = locate_block(text, "topic-block", topic_id)
        entry_loc = locate_block(text, "entry-block", current_id)
        if entry_loc is not None:
            text, _ = replace_field(text, "question", current_id, question_heading(meta), required=True)
            text, _ = replace_field(text, "code", current_id, fence(meta["code"], "c"), required=True)
            text, _ = replace_field(text, "freshness", current_id, freshness, required=True)
            text, _ = replace_field(text, "output", current_id, fence(output_display, "text"), required=True)
            if topic_loc is None:
                die(f"output.md has a question block for {current_id} but no topic block {topic_id}; left it untouched")
            text, _ = replace_field(text, "topic", topic_id, topic_heading(meta), required=True)
        else:
            new_entry = create_entry_block(meta, output_display, freshness)
            if topic_loc is None:
                topic_contents = "\n".join([
                    marker("topic-block", topic_id, "start"),
                    "",
                    marker("topic", topic_id, "start"),
                    "",
                    topic_heading(meta),
                    "",
                    marker("topic", topic_id, "end"),
                    "",
                    new_entry,
                    marker("topic-block", topic_id, "end"),
                ])
                if text and not text.endswith("\n"):
                    text += "\n"
                if text and not text.endswith("\n\n"):
                    text += "\n"
                text += topic_contents + "\n"
            else:
                end_marker = marker("topic-block", topic_id, "end")
                end_pos = text.index(end_marker, topic_loc[0], topic_loc[1])
                prefix = text[:end_pos]
                suffix = text[end_pos:]
                sep = "\n" if prefix.endswith("\n\n") else "\n\n"
                text = prefix + sep + new_entry + "\n\n" + suffix
    # Note: all other user-authored Markdown remains byte-for-byte intact outside managed fields.
    return original, text


def atomic_write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.qrun-", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp_name, path)
    except Exception:
        try:
            os.unlink(tmp_name)
        except OSError:
            pass
        raise


def update_record_object(entry, meta):
    changed_code = entry.get("code_sha256") != meta["code_sha256"] or entry.get("code") != meta["code"]
    stamp = now()
    fields = ("id", "topic", "topic_index", "question_number", "question", "source_file", "code", "code_sha256")
    changed_any = False
    for key in fields:
        value = meta[key]
        if entry.get(key) != value:
            entry[key] = value
            changed_any = True
    if changed_code or "code_updated_at" not in entry:
        entry["code_updated_at"] = stamp
        changed_any = True
    return changed_any


def load_transcript(path):
    try:
        raw = Path(path).read_bytes()
    except OSError as exc:
        die(f"cannot read captured terminal output ({exc})")
    text = raw.decode("utf-8", errors="replace")
    # Remove common ANSI/terminal control sequences but retain visible terminal text and echoed input.
    text = re.sub(r"\x1b\][^\x07]*(?:\x07|\x1b\\)", "", text)
    text = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", text)
    text = re.sub(r"\x1b[P^_].*?\x1b\\", "", text, flags=re.DOTALL)
    text = text.replace("\r\n", "\n")
    text = text.replace("\r", "\n")
    # util-linux `script` adds metadata lines to its typescript file; they are not terminal output.
    text = re.sub(r"(?m)^Script started on [^\n]*\n", "", text, count=1)
    text = re.sub(r"\n?Script done on [^\n]*(?:\n)?\Z", "", text, count=1)
    # Emulate simple backspace editing in echoed terminal input.
    chars = []
    for ch in text:
        if ch == "\x08" or ch == "\x7f":
            if chars and chars[-1] not in ("\n", "\r"):
                chars.pop()
        elif ch in ("\x00", "\x01", "\x02", "\x03", "\x04", "\x05", "\x06", "\x0e", "\x0f", "\x10", "\x11", "\x12", "\x13", "\x14", "\x15", "\x16", "\x17", "\x18", "\x19", "\x1a", "\x1c", "\x1d", "\x1e", "\x1f"):
            continue
        else:
            chars.append(ch)
    return "".join(chars)


def run_helper(action, *args):
    if action not in ("sync", "record"):
        die("internal updater called with unknown action")
    root = Path(args[0]).resolve()
    md_path = root / "output.md"
    json_path = root / "output.json"
    lock_path = root / ".qrun.lock"
    # Serialize only the short database update. The lock file is intentionally persistent to avoid lock races.
    import fcntl
    root.mkdir(parents=True, exist_ok=True)
    with lock_path.open("a+") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        sources = scan_sources(root)
        current_id = None
        current_output = None
        command = None
        exit_code = None
        mode = None
        if action == "record":
            if len(args) != 6:
                die("internal record arguments are incomplete")
            source_arg, transcript_path, command, status_text, mode = args[1:6]
            try:
                source_path = Path(source_arg).resolve()
            except OSError as exc:
                die(f"cannot resolve source path ({exc})")
            meta = parse_question_file(source_path, root)
            if meta is None:
                die(f"source filename must be q-NN-KK.c (for example q-00-01.c): {source_path.name}")
            # If source is outside cwd, include it for this record too.
            sources[meta["id"]] = meta
            current_id = meta["id"]
            current_output = load_transcript(transcript_path)
            try:
                exit_code = int(status_text)
            except ValueError:
                exit_code = 1

        data, json_existed = load_json(json_path)
        old_json = json.dumps(data, ensure_ascii=False, indent=2) + "\n"
        id_to_entry = {item.get("id"): item for item in data["entries"] if item.get("id")}
        json_changed = False
        for qid, meta in sources.items():
            if qid in id_to_entry:
                if update_record_object(id_to_entry[qid], meta):
                    id_to_entry[qid]["updated_at"] = now()
                    json_changed = True
        if current_id is not None:
            meta = sources[current_id]
            entry = id_to_entry.get(current_id)
            if entry is None:
                entry = {"id": current_id, "runs": [], "run_count": 0, "created_at": now()}
                data["entries"].append(entry)
                id_to_entry[current_id] = entry
                json_changed = True
            if update_record_object(entry, meta):
                json_changed = True
            # Keep unknown/custom fields on existing entries and append each run to history.
            runs = entry.get("runs", [])
            if not isinstance(runs, list):
                die(f'{json_path.name}: "runs" for {current_id} must be an array; left it untouched')
            run_stamp = now()
            run_record = {
                "run_number": len(runs) + 1,
                "timestamp": run_stamp,
                "command": command,
                "mode": mode,
                "output": current_output,
                "exit_code": exit_code,
                "code_sha256": meta["code_sha256"],
            }
            runs.append(run_record)
            entry["runs"] = runs
            entry["run_count"] = int(entry.get("run_count", 0)) + 1
            entry["command"] = command
            entry["output"] = current_output
            entry["exit_code"] = exit_code
            entry["last_run_at"] = run_stamp
            entry["updated_at"] = run_stamp
            json_changed = True

        # Keep an explicit flag when the current source differs from the source version that produced the latest output.
        for qid, meta in sources.items():
            entry = id_to_entry.get(qid)
            if entry is None:
                continue
            runs = entry.get("runs", [])
            latest_hash = runs[-1].get("code_sha256") if isinstance(runs, list) and runs and isinstance(runs[-1], dict) else None
            stale = bool(latest_hash and latest_hash != meta["code_sha256"])
            if entry.get("output_stale") != stale:
                entry["output_stale"] = stale
                json_changed = True

        old_md, new_md = update_markdown(md_path, sources, data["entries"], current_id, None if current_id is None else "\n".join([f"$ {command}", current_output]).rstrip("\n"))
        # If output is empty, keep the command line and don't invent a no-output message.
        if new_md != old_md:
            atomic_write(md_path, new_md)
        new_json = json.dumps(data, ensure_ascii=False, indent=2) + "\n"
        if not json_path.exists() or new_json != old_json:
            atomic_write(json_path, new_json)
        if action == "record":
            print(f"qrun: recorded {current_id} in output.md and output.json (exit code {exit_code})")
        else:
            count = sum(1 for qid in sources if qid in id_to_entry)
            print(f"qrun: scanned {len(sources)} source file(s); refreshed {count} existing record(s)")


try:
    if not sys.argv[1:]:
        die("internal updater arguments missing")
    run_helper(sys.argv[1], *sys.argv[2:])
except SystemExit:
    raise
except Exception as exc:
    die(f"unexpected updater failure: {exc}")
PYTHON_HELPER
fi

usage() {
    cat <<'USAGE'
Usage:
  qrun q-NN-KK.c                  Compile the C file and run it interactively, capturing terminal output.
  qrun --run q-NN-KK.c -- ./a.out Run an already-built executable while logging its output against the source file.
  qrun --sync                      Scan q-*.c files and refresh code/question metadata in existing records.
  qrun --help                      Show this help.

Files are written in the current directory: output.md and output.json.
Interactive capture requires util-linux `script` and Python 3.
USAGE
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
    exit 0
fi

if [[ "${1:-}" == "--sync" ]]; then
    bash "$SELF_PATH" --_update sync "$PWD"
    exit $?
fi

mode="compile-run"
source_arg=""
cmd_args=()
if [[ "${1:-}" == "--run" || "${1:-}" == "--source" ]]; then
    mode="run-existing"
    shift
    if [[ $# -lt 3 ]]; then
        usage >&2
        exit 2
    fi
    source_arg=$1
    shift
    if [[ "${1:-}" != "--" ]]; then
        echo "qrun: expected -- before the executable command" >&2
        usage >&2
        exit 2
    fi
    shift
    if [[ $# -lt 1 ]]; then
        echo "qrun: no executable command supplied" >&2
        exit 2
    fi
    cmd_args=("$@")
else
    if [[ $# -ne 1 ]]; then
        usage >&2
        exit 2
    fi
    source_arg=$1
fi

if [[ ! -f "$source_arg" ]]; then
    echo "qrun: source file not found: $source_arg" >&2
    exit 2
fi
base_name=$(basename -- "$source_arg")
if [[ ! "$base_name" =~ ^q-[0-9]{2,}-[0-9]{2,}\.c$ ]]; then
    echo "qrun: expected a source named q-NN-KK.c (for example q-00-01.c), got: $base_name" >&2
    exit 2
fi
if ! command -v python3 >/dev/null 2>&1; then
    echo "qrun: Python 3 is required for safe Markdown/JSON updates" >&2
    exit 2
fi
if ! command -v script >/dev/null 2>&1; then
    echo "qrun: util-linux 'script' is required to capture interactive terminal input/output." >&2
    echo "       On Ubuntu/WSL install it with: sudo apt update && sudo apt install util-linux" >&2
    exit 2
fi

source_abs=$(realpath -- "$source_arg") || exit 2
id_parts=$(python3 - "$base_name" <<'PY_ID'
import re,sys
m=re.fullmatch(r'q-(\d+)-(\d+)\.c',sys.argv[1])
print(f'q-{int(m.group(1)):02d}-{int(m.group(2)):02d}')
PY_ID
) || exit 2
mkdir -p -- bin || exit 1
binary="./bin/$id_parts.out"

shell_quote() {
    local s=$1
    s=${s//\'/\'\\\'\'}
    printf "'%s'" "$s"
}

join_quoted() {
    local first=1 arg
    for arg in "$@"; do
        if (( first )); then first=0; else printf ' '; fi
        shell_quote "$arg"
    done
}

display_quote() {
    local s=$1
    if [[ "$s" =~ ^[a-zA-Z0-9_./:+,=@%-]+$ ]]; then
        printf '%s' "$s"
    else
        shell_quote "$s"
    fi
}

join_display() {
    local first=1 arg
    for arg in "$@"; do
        if (( first )); then first=0; else printf ' '; fi
        display_quote "$arg"
    done
}

if [[ "$mode" == "compile-run" ]]; then
    cc_words=()
    cflag_words=()
    read -r -a cc_words <<< "${CC:-gcc}"
    read -r -a cflag_words <<< "${CFLAGS:-}"
    if [[ ${#cc_words[@]} -eq 0 ]]; then
        echo "qrun: CC is empty" >&2
        exit 2
    fi
    if ! command -v "${cc_words[0]}" >/dev/null 2>&1; then
        echo "qrun: compiler not found: ${cc_words[0]} (set CC if needed)" >&2
        exit 2
    fi
    # Compile and run from the caller's working directory via a pseudo-terminal.
    compiler_args=("${cc_words[@]}" "${cflag_words[@]}" "$source_arg" -o "$binary")
    quoted_compile=$(join_quoted "${compiler_args[@]}")
    quoted_run=$(shell_quote "$binary")
    shown_compile=$(join_display "${compiler_args[@]}")
    shown_run=$(display_quote "$binary")
    shell_command="$quoted_compile && $quoted_run"
    display_command="$shown_compile && $shown_run"
else
    shell_command=$(join_quoted "${cmd_args[@]}")
    display_command=$(join_display "${cmd_args[@]}")
fi

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/qrun.XXXXXXXX") || exit 1
raw_log="$tmp_dir/terminal.log"
cleanup() { rm -rf -- "$tmp_dir"; }
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

printf 'qrun: capturing terminal session for %s\n' "$base_name"
# -q hides script's own banner, -e returns the child status, -f flushes output promptly.
script -qefc "$shell_command" "$raw_log"
run_status=$?

bash "$SELF_PATH" --_update record "$PWD" "$source_abs" "$raw_log" "$display_command" "$run_status" "$mode"
log_status=$?
if [[ $log_status -ne 0 ]]; then
    echo "qrun: execution finished with status $run_status, but logging failed" >&2
    exit "$log_status"
fi

# Automatically stage the current source file and output logs.
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git add -- "$source_abs" output.md output.json || {
        echo "qrun: WARNING: Git staging failed." >&2
    }
fi

exit "$run_status"

